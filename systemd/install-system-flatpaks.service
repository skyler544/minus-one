[Unit]
Description=Install system Flatpaks
Wants=network-online.target
After=network-online.target replace-fedora-flatpak-remotes.service replace-installed-fedora-flatpaks.service
ConditionPathExists=!/var/lib/flatpak/.minus-one-system-flatpaks-installed

[Service]
Type=oneshot
ExecStart=-/usr/sbin/flatpak install --assumeyes --noninteractive ca.desrt.dconf-editor
ExecStart=-/usr/sbin/flatpak install --assumeyes --noninteractive com.github.tchx84.Flatseal
ExecStart=-/usr/sbin/flatpak install --assumeyes --noninteractive com.mattjakeman.ExtensionManager
ExecStart=-/usr/sbin/flatpak install --assumeyes --noninteractive com.ranfdev.DistroShelf
ExecStart=-/usr/sbin/flatpak install --assumeyes --noninteractive io.github.celluloid_player.Celluloid
ExecStart=-/usr/sbin/flatpak install --assumeyes --noninteractive io.github.fabrialberio.pinapp
ExecStart=-/usr/sbin/flatpak install --assumeyes --noninteractive io.github.flattool.Ignition
ExecStart=-/usr/sbin/flatpak install --assumeyes --noninteractive io.github.flattool.Warehouse
ExecStart=-/usr/sbin/flatpak install --assumeyes --noninteractive io.github.kolunmi.Bazaar
ExecStart=-/usr/sbin/flatpak install --assumeyes --noninteractive io.missioncenter.MissionCenter
ExecStart=-/usr/sbin/flatpak install --assumeyes --noninteractive io.podman_desktop.PodmanDesktop
ExecStart=-/usr/sbin/flatpak install --assumeyes --noninteractive org.gnome.Calculator
ExecStart=-/usr/sbin/flatpak install --assumeyes --noninteractive org.gnome.Calendar
ExecStart=-/usr/sbin/flatpak install --assumeyes --noninteractive org.gnome.Evolution
ExecStart=-/usr/sbin/flatpak install --assumeyes --noninteractive org.gnome.FileRoller
ExecStart=-/usr/sbin/flatpak install --assumeyes --noninteractive org.gnome.Firmware
ExecStart=-/usr/sbin/flatpak install --assumeyes --noninteractive org.gnome.Logs
ExecStart=-/usr/sbin/flatpak install --assumeyes --noninteractive org.gnome.Loupe
ExecStart=-/usr/sbin/flatpak install --assumeyes --noninteractive org.gnome.Loupe.HEIC
ExecStart=-/usr/sbin/flatpak install --assumeyes --noninteractive org.gnome.NautilusPreviewer
ExecStart=-/usr/sbin/flatpak install --assumeyes --noninteractive org.gnome.Papers
ExecStart=-/usr/sbin/flatpak install --assumeyes --noninteractive org.gnome.SimpleScan
ExecStart=-/usr/sbin/flatpak install --assumeyes --noninteractive org.gnome.Snapshot
ExecStart=-/usr/sbin/flatpak install --assumeyes --noninteractive org.gnome.SoundRecorder
ExecStart=-/usr/sbin/flatpak install --assumeyes --noninteractive org.gnome.Weather
ExecStart=-/usr/sbin/flatpak install --assumeyes --noninteractive org.gnome.baobab
ExecStart=-/usr/sbin/flatpak install --assumeyes --noninteractive org.gnome.clocks
ExecStart=-/usr/sbin/flatpak install --assumeyes --noninteractive org.gtk.Gtk3theme.adw-gtk3
ExecStart=-/usr/sbin/flatpak install --assumeyes --noninteractive org.gtk.Gtk3theme.adw-gtk3-dark
ExecStart=-/usr/sbin/flatpak install --assumeyes --noninteractive org.mozilla.firefox
ExecStart=-/usr/sbin/flatpak install --assumeyes --noninteractive org.pipewire.Helvum
ExecStart=-/usr/sbin/flatpak install --assumeyes --noninteractive page.tesk.Refine
ExecStartPost=/usr/sbin/touch /var/lib/flatpak/.minus-one-system-flatpaks-installed
